        faceTrackingParameterBehaviors:
        - targetMode: 2
          outputParameterName: NewParameter15
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedLeft
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeClosedLeft * (1 + EyeSquintLeft / 3) - EyeSquintLeft
            / 3
        - targetMode: 2
          outputParameterName: NewParameter16
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedRight
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeClosedRight * (1 + EyeSquintRight / 3) - EyeSquintRight
            / 3
        - targetMode: 2
          outputParameterName: NewParameter20
          targetBlendSetName: 
          targetBlendshapeName: BrowInnerUp
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (BrowInnerUpLeft + BrowInnerUpRight + (MouthFrownLeft
            + MouthFrownRight) * (1 - MouthClosed / 2)) / 2
        - targetMode: 2
          outputParameterName: NewParameter18
          targetBlendSetName: 
          targetBlendshapeName: BrowDownLeft
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowLowererLeft * 0.75 + BrowPinchLeft * 0.25 + (NoseSneerLeft
            + NoseSneerRight) / 2 + MouthRaiserLower
        - targetMode: 2
          outputParameterName: NewParameter19
          targetBlendSetName: 
          targetBlendshapeName: BrowDownRight
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowLowererRight * 0.75 + BrowPinchRight * 0.25 + (NoseSneerLeft
            + NoseSneerRight) / 2 + MouthRaiserLower
        - targetMode: 2
          outputParameterName: NewParameter21
          targetBlendSetName: 
          targetBlendshapeName: NoseSneer
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (NoseSneerLeft + NoseSneerRight) / 2
        - targetMode: 2
          outputParameterName: NewParameter22
          targetBlendSetName: 
          targetBlendshapeName: MouthSmileLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullLeft * 0.8 + MouthCornerSlantLeft * 0.2
        - targetMode: 2
          outputParameterName: NewParameter23
          targetBlendSetName: 
          targetBlendshapeName: MouthSmileRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullRight * 0.8 + MouthCornerSlantRight *
            0.2
        - targetMode: 2
          outputParameterName: NewParameter24
          targetBlendSetName: 
          targetBlendshapeName: MouthLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthUpperLeft + MouthLowerLeft) / 2
        - targetMode: 2
          outputParameterName: NewParameter25
          targetBlendSetName: 
          targetBlendshapeName: MouthRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthUpperRight + MouthLowerRight) / 2
        - targetMode: 2
          outputParameterName: NewParameter26
          targetBlendSetName: 
          targetBlendshapeName: LipFunnel
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (LipFunnelUpperLeft + LipFunnelUpperRight + LipFunnelLowerLeft
            + LipFunnelLowerRight) / 4
        - targetMode: 2
          outputParameterName: NewParameter17
          targetBlendSetName: 
          targetBlendshapeName: MouthPress
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthPressRight + MouthPressLeft) / 2
        - targetMode: 2
          outputParameterName: NewParameter1
          targetBlendSetName: 
          targetBlendshapeName: JawOpen
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawOpen * (1 - TongueOut / 4) + TongueOut / 4
        - targetMode: 2
          outputParameterName: NewParameter2
          targetBlendSetName: 
          targetBlendshapeName: JawLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawLeft * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: NewParameter3
          targetBlendSetName: 
          targetBlendshapeName: JawRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawRight * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: NewParameter4
          targetBlendSetName: 
          targetBlendshapeName: MouthUpperUpLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthUpperUpLeft * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter5
          targetBlendSetName: 
          targetBlendshapeName: MouthUpperUpRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthUpperUpRight * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter6
          targetBlendSetName: 
          targetBlendshapeName: MouthLowerDown
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((MouthLowerDownRight + MouthLowerDownLeft) / 2) * (1
            - (LipFunnelUpperLeft + LipFunnelUpperRight + LipFunnelLowerLeft + LipFunnelLowerRight)
            / 4)
        - targetMode: 2
          outputParameterName: NewParameter7
          targetBlendSetName: 
          targetBlendshapeName: MouthFrownLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthFrownLeft * (1 - (MouthUpperLeft + MouthLowerLeft)
            / 6)
        - targetMode: 2
          outputParameterName: NewParameter8
          targetBlendSetName: 
          targetBlendshapeName: MouthFrownRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthFrownRight * (1 - (MouthUpperRight + MouthLowerRight)
            / 6)
        - targetMode: 2
          outputParameterName: NewParameter9
          targetBlendSetName: 
          targetBlendshapeName: LipPucker
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipPuckerUpperRight + LipPuckerUpperLeft + LipPuckerLowerRight
            + LipPuckerLowerLeft) / 4) * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter10
          targetBlendSetName: 
          targetBlendshapeName: LipSuckUpper
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipSuckUpperRight + LipSuckUpperLeft) / 2) * (1 - MouthClosed
            / 3)
        - targetMode: 2
          outputParameterName: NewParameter11
          targetBlendSetName: 
          targetBlendshapeName: LipSuckLower
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipSuckLowerRight + LipSuckLowerLeft) / 2) * (1 - MouthClosed
            / 3)
        - targetMode: 2
          outputParameterName: NewParameter12
          targetBlendSetName: 
          targetBlendshapeName: MouthRaiserUpper
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthRaiserUpper * (1 - MouthClosed)
        - targetMode: 2
          outputParameterName: NewParameter13
          targetBlendSetName: 
          targetBlendshapeName: MouthRaiserLower
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthRaiserLower * (1 - MouthClosed)
        - targetMode: 2
          outputParameterName: NewParameter14
          targetBlendSetName: 
          targetBlendshapeName: TongueOut
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: TongueOut * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 2.8)
        - targetMode: 2
          outputParameterName: NewParameter28
          targetBlendSetName: 
          targetBlendshapeName: BrowOuterUpLeft
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowOuterUpLeft + EyeWideLeft / 3
        - targetMode: 2
          outputParameterName: NewParameter27
          targetBlendSetName: 
          targetBlendshapeName: BrowOuterUpRight
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowOuterUpRight + EyeWideRight / 3
        - targetMode: 2
          outputParameterName: NewParameter29
          targetBlendSetName: 
          targetBlendshapeName: EyeConstrict
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (EyeWideLeft + EyeWideRight + EyeConstrictLeft + EyeConstrictRight)
            / 2
        - targetMode: 2
          outputParameterName: NewParameter30
          targetBlendSetName: 
          targetBlendshapeName: EyeDilation
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthFrownLeft + MouthFrownRight - EyeWideLeft - EyeWideRight
            + EyeDilationLeft + EyeDilationRight) / 2
        - targetMode: 2
          outputParameterName: NewParameter31
          targetBlendSetName: 
          targetBlendshapeName: CheekSquintLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullLeft * 0.4 + MouthCornerSlantLeft * 0.1
        - targetMode: 2
          outputParameterName: NewParameter32
          targetBlendSetName: 
          targetBlendshapeName: CheekSquintRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullRight * 0.4 + MouthCornerSlantRight *
            0.1
        - targetMode: 2
          outputParameterName: NewParameter33
          targetBlendSetName: 
          targetBlendshapeName: MouthDimpleLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullLeft * 0.4 + MouthCornerSlantLeft * 0.1
        - targetMode: 2
          outputParameterName: NewParameter34
          targetBlendSetName: 
          targetBlendshapeName: MouthDimpleRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullRight * 0.4 + MouthCornerSlantRight *
            0.1
